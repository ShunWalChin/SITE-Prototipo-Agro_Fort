{
  "metadata": {
    "project": "Agrofort_Web_System",
    "repository": "ShunWalChin/SITE-Prototipo-Agro_Fort",
    "target_environment": "production",
    "execution_profile": "senior_engineer_max_optimization"
  },
  "quality_gates": {
    "required": [
      "npm run check",
      "npx knip --production",
      "npm run security:audit"
    ],
    "pass_conditions": {
      "lint_errors": 0,
      "typescript_errors": 0,
      "test_failures": 0,
      "production_dead_exports": 0,
      "high_or_critical_cves": 0
    }
  },
  "pipeline_stages": [
    {
      "id": "stage_1_code_audit_and_debug",
      "name": "Varredura e refinamento de código",
      "actions": [
        {
          "task": "dead_code_elimination",
          "command": "npx knip --production && npm run typecheck"
        },
        {
          "task": "ux_ui_heuristics_apply",
          "command": "npm run lint -- --fix && npm run check"
        }
      ]
    },
    {
      "id": "stage_2_security_and_pentest",
      "name": "Hardening e análise de vulnerabilidades",
      "actions": [
        {
          "task": "dependency_audit",
          "command": "npm run security:audit"
        },
        {
          "task": "automated_dast_pentest",
          "command": "docker run --rm -v \"$PWD/zap-reports:/zap/wrk:rw\" ghcr.io/zaproxy/zaproxy:stable zap-baseline.py -t \"$PUBLIC_URL\" -I -J zap-report.json -r zap-report.html -w zap-report.md"
        }
      ]
    },
    {
      "id": "stage_3_documentation_generation",
      "name": "Documentação",
      "actions": [
        {
          "task": "validate_project_documentation",
          "command": "test -s docs/ARCHITECTURE.md && test -s docs/USER-MANUAL.md && test -s docs/FINAL-REPORT.md"
        }
      ]
    },
    {
      "id": "stage_4_deployment",
      "name": "Build e atualização transacional",
      "actions": [
        {
          "task": "production_build",
          "command": "npm run build"
        },
        {
          "task": "immutable_release",
          "command": "bash /home/opc/apps/agrofort/current/deploy/deploy-remote.sh \"$RELEASE_ID\" \"/home/opc/apps/agrofort/incoming/agrofort-$RELEASE_ID.tar.gz\""
        }
      ]
    },
    {
      "id": "stage_5_version_control",
      "name": "Sincronização e relatório final",
      "actions": [
        {
          "task": "git_push_review_branch",
          "command": "git push -u origin agent/full-system-audit"
        },
        {
          "task": "review_pull_request",
          "command": "gh pr view 1 --repo ShunWalChin/SITE-Prototipo-Agro_Fort --web"
        }
      ]
    }
  ]
}
